#. Description for command "mvz2:spawn"
#: Commands meta file
msgctxt "command.description"
msgid "生成一个实体。"
msgstr "Spawns an entity."

#. Description for command variant "mvz2:spawn pos"
#: Commands meta file
msgctxt "command_variant.description"
msgid "生成一个实体。默认位置为场地中心。"
msgstr ""
"Spawns an entity. The default location is the center of the battlefield."

#. Description for parameter id of command "mvz2:spawn pos"
#: Commands meta file
msgctxt "command_parameter.description"
msgid "要生成的实体ID。"
msgstr "The ID of the entity to spawn."

#. Description for parameter x of command "mvz2:spawn pos"
#: Commands meta file
msgctxt "command_parameter.description"
msgid "可选。要生成的实体位置的X值。"
msgstr "Optional. The X position where the entity is spawned at."

#. Description for parameter y of command "mvz2:spawn pos"
#: Commands meta file
msgctxt "command_parameter.description"
msgid "可选。要生成的实体位置的Y值。"
msgstr "Optional. The Y position where the entity is spawned at."

#. Description for parameter z of command "mvz2:spawn pos"
#: Commands meta file
msgctxt "command_parameter.description"
msgid "可选。要生成的实体位置的Z值。"
msgstr "Optional. The Z position where the entity is spawned at."

#. Description for parameter faction of command "mvz2:spawn pos"
#: Commands meta file
msgctxt "command_parameter.description"
msgid "可选。要生成的实体的阵营。0为友方，1为敌方。"
msgstr ""
"Optional. The faction of the entity to spawn. 0 is friendly, 1 is enemy."

#. Description for command variant "mvz2:spawn tile"
#: Commands meta file
msgctxt "command_variant.description"
msgid "在指定的地格位置生成实体。默认位置为场地中心。"
msgstr ""
"Spawns an entity on a certain tile. The default location is the center of "
"the battlefield."

#. Description for parameter column of command "mvz2:spawn tile"
#: Commands meta file
msgctxt "command_parameter.description"
msgid "可选。实体所在列。0代表最左侧一列，向右递增。"
msgstr ""
"Optional. The column where the entity is spawned at. 0 represents the "
"leftmost column, increasing to the right."

#. Description for parameter lane of command "mvz2:spawn tile"
#: Commands meta file
msgctxt "command_parameter.description"
msgid "可选。实体所在行。0代表最上方一行，向下递增。"
msgstr ""
"Optional. The lane where the entity is spawned at. 0 represents the topmost "
"lane, increasing to the bottom."

#. Description for command "mvz2:kill"
#: Commands meta file
msgctxt "command.description"
msgid "杀死实体。"
msgstr "Kills entities."

#. Description for command variant "mvz2:kill "
