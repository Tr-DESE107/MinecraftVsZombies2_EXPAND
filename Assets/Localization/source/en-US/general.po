msgid "可选。掉落物所在列。0代表最左侧一列，向右递增。"
msgstr ""
"Optional. The column where the pickup is spawned at. 0 represents the "
"leftmost column, increasing to the right."

#. Description for parameter lane of command "mvz2:spawnblueprint tile"
#: Commands meta file
msgctxt "command_parameter.description"
msgid "可选。掉落物所在行。0代表最上方一行，向下递增。"
msgstr ""
"Optional. The lane where the pickup is spawned at. 0 represents the topmost "
"lane, increasing to the bottom."

#. Description for command "mvz2:artifact"
#: Commands meta file
msgctxt "command.description"
msgid "调整制品。"
msgstr "Adjusts artifacts."

#. Description for command variant "mvz2:artifact set"
#: Commands meta file
msgctxt "command_variant.description"
msgid "将某槽位的制品替换为指定ID的制品。"
msgstr ""
"Replace the artifact of a certain slot with the artifact of the specified ID."

#. Description for parameter slot of command "mvz2:artifact set"
#: Commands meta file
msgctxt "command_parameter.description"
msgid "制品槽位，0代表第一个槽位，1代表第二个槽位，依此类推。"
msgstr ""
"Artifact slot, 0 represents the first slot, 1 represents the second slot, "
"and so on."

#. Description for parameter id of command "mvz2:artifact set"
#: Commands meta file
msgctxt "command_parameter.description"
msgid "制品ID。"
msgstr "The ID of the artifact."

#. Description for command variant "mvz2:artifact remove"
#: Commands meta file
msgctxt "command_variant.description"
msgid "移除指定槽位的制品。"
msgstr "Removes the artifact of a certain slot."

#. Description for command "mvz2:unlock"
#: Commands meta file
msgctxt "command.description"
msgid "解锁或重新锁定某些游戏状态。"
msgstr "Unlocks or relocks some game state."

#. Description for command variant "mvz2:unlock add"
#: Commands meta file
msgctxt "command_variant.description"
msgid "解锁游戏状态。"
msgstr "Unlocks a game state."

#. Description for parameter id of command "mvz2:unlock add"
#: Commands meta file
msgctxt "command_parameter.description"
msgid "状态ID。"
msgstr "State ID."

#. Description for command variant "mvz2:unlock remove"
#: Commands meta file
msgctxt "command_variant.description"
msgid "重新锁定游戏状态。"
msgstr "Relocks a game state."

#. Description for command variant "mvz2:unlock list"
#: Commands meta file
msgctxt "command_variant.description"
msgid "打印当前存档所有目前解锁的游戏状态。"
msgstr "Prints all currently unlocked game states of the current user."

#. Description for command variant "mvz2:unlock listlocked"
#: Commands meta file
msgctxt "command_variant.description"
msgid "打印当前存档所有目前尚未解锁的游戏状态。"
msgstr "Prints all currently locked game states of the current user."

#. Description for command variant "mvz2:unlock all"
#: Commands meta file
msgctxt "command_variant.description"
msgid "解锁所有游戏状态。"
msgstr "Unlocks all game states."

#. Description for command variant "mvz2:unlock none"
#: Commands meta file
msgctxt "command_variant.description"
msgid "锁定所有游戏状态。"
msgstr "Relocks all game states."

#. Description for command "mvz2:test"
#: Commands meta file
msgctxt "command.description"
msgid "进行某些测试。"
msgstr "Do some tests."

#. Description for command variant "mvz2:test spawnenemies"
#: Commands meta file
msgctxt "command_variant.description"
msgid "生成一页不同的怪物。"
msgstr "Spawns a page of different monsters."

#. Description for parameter page of command "mvz2:test spawnenemies"
#: Commands meta file
msgctxt "command_parameter.description"
msgid "可选。怪物页数。"
msgstr "Optional. The page number of monsters."

#. Description for command variant "mvz2:test armor"
#: Commands meta file
msgctxt "command_variant.description"
msgid "使所有怪物戴上盔甲。"
msgstr "Equips helmets to all monsters."

#. Description for parameter id of command "mvz2:test armor"
#: Commands meta file
msgctxt "command_parameter.description"
msgid "盔甲ID。"
msgstr "Armor ID."

#. Description for command variant "mvz2:test shield"
#: Commands meta file
msgctxt "command_variant.description"
msgid "使所有怪物拿起护盾。"
msgstr "Equips shields to all monsters."

#. Description for command variant "mvz2:test paratroops"
#: Commands meta file
msgctxt "command_variant.description"
msgid "生成一队伞兵僵尸。"
msgstr "Spawns a group of Paratroop Zombies."

#. Description for command variant "mvz2:test wave"
#: Commands meta file
msgctxt "command_variant.description"
msgid "设置当前关卡波数。"
msgstr "Sets the current wave number."

#. Description for parameter wave of command "mvz2:test wave"
#: Commands meta file
msgctxt "command_parameter.description"
msgid "要设置的波数。"
msgstr "Wave number to set."

#. Description for command variant "mvz2:test flags"
#: Commands meta file
msgctxt "command_variant.description"
msgid "设置当前轮数。"
msgstr "Sets the current flags."

#. Description for parameter flags of command "mvz2:test flags"
#: Commands meta file
msgctxt "command_parameter.description"
msgid "要设置的轮数。"
msgstr "Flags to set."

#. Description for command "mvz2:izombie"
#: Commands meta file
msgctxt "command.description"
msgid "针对“我是僵尸”关卡进行操作。"
msgstr "Operate on the \"I, Zombie\" level."

#. Description for command variant "mvz2:izombie layout"
#: Commands meta file
msgctxt "command_variant.description"
msgid "以特定布局刷新当前场地。"
msgstr "Refreshes current battlefield with a specific layout."

#. Description for parameter id of command "mvz2:izombie layout"
#: Commands meta file
msgctxt "command_parameter.description"
msgid "可选。我是僵尸布局ID。默认为随机布局。"
msgstr "Optional. I, Zombie layout ID. The default a random layout."

#. Description for command variant "mvz2:izombie pickaxe"
#: Commands meta file
msgctxt "command_variant.description"
msgid "设置铁镐可使用次数。"
msgstr "Sets the usage time of the Pickaxe."

#. Description for parameter count of command "mvz2:izombie pickaxe"
#: Commands meta file
msgctxt "command_parameter.description"
msgid "可使用次数。"
msgstr "Usage times."

#. Description for command "mvz2:gotolevel"
#: Commands meta file
msgctxt "command.description"
msgid "进入一个指定的关卡。"
msgstr "Enter a specific stage."

#. Description for command variant "mvz2:gotolevel "
#: Commands meta file
msgctxt "command_variant.description"
msgid "进入一个指定的关卡。"
msgstr "Enter a specific stage."

#. Description for parameter stage of command "mvz2:gotolevel "
#: Commands meta file
msgctxt "command_parameter.description"
msgid "要进入的关卡ID。"
msgstr "Stage ID to enter."

#. Description for parameter area of command "mvz2:gotolevel "
#: Commands meta file
msgctxt "command_parameter.description"
msgid "要进入的场地ID。"
msgstr "Area ID to enter."

#. Description for command "mvz2:chaptertransition"
#: Commands meta file
msgctxt "command.description"
msgid "播放一段章节过渡动画。"
msgstr "Plays a chapter transition animation."

#. Description for command variant "mvz2:chaptertransition start"
#: Commands meta file
msgctxt "command_variant.description"
msgid "播放章节开始动画。"
msgstr "Plays the chapter start transition."

#. Description for parameter stage of command "mvz2:chaptertransition start"
#: Commands meta file
msgctxt "command_parameter.description"
msgid "章节过渡动画ID。"
msgstr "Chapter transition ID."

#. Description for command variant "mvz2:chaptertransition end"
#: Commands meta file
msgctxt "command_variant.description"
msgid "播放章节结束动画。"
msgstr "Plays the chapter end transition."

