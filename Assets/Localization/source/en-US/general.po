msgstr "About"

#. Label for option widget 语言
#: Option meta file
msgctxt "option.name"
msgid "语言"
msgstr "Language"

#. Label for option widget 震动
#: Option meta file
msgctxt "option.name"
msgid "震动"
msgstr "Vibration"

#. Tooltip for option widget （仅限移动端）是否在屏幕震动时震动设备。
#: Option meta file
msgctxt "option.tooltip"
msgid "（仅限移动端）是否在屏幕震动时震动设备。"
msgstr "(Mobile only) Option to vibrate device during screen shakes."

#. Label for option widget 跳过对话
#: Option meta file
msgctxt "option.name"
msgid "跳过对话"
msgstr "Skip dialogues"

#. Tooltip for option widget 是否自动跳过所有剧情对话。
#: Option meta file
msgctxt "option.tooltip"
msgid "是否自动跳过所有剧情对话。"
msgstr "Option to automatically skip story dialogues."

#. Label for option widget 选卡警告
#: Option meta file
msgctxt "option.name"
msgid "选卡警告"
msgstr "Blueprint Warnings"

#. Tooltip for option widget 是否在蓝图选择完毕后，根据当前情况提出警告。
#: Option meta file
msgctxt "option.tooltip"
msgid "是否在蓝图选择完毕后，根据当前情况提出警告。"
msgstr ""
"Option to display warnings after selecting blueprints based on the current "
"situation."

#. Label for option widget 赞助者名称
#: Option meta file
msgctxt "option.name"
msgid "赞助者名称"
msgstr "Sponsor Names"

#. Tooltip for option widget 在关卡中放置特定器械时，是否随机显示赞助了对应方案的赞助者的名称。
#: Option meta file
msgctxt "option.tooltip"
msgid "在关卡中放置特定器械时，是否随机显示赞助了对应方案的赞助者的名称。"
msgstr ""
"When placing specific contraptions in a level, option to randomly display "
"the names of sponsors who supported the corresponding tier."

# 命令方块蓝图名，{0}为原名称
#. Label for option widget 命令方块
#: Option meta file
msgctxt "option.name"
msgid "命令方块"
msgstr "Command Block Mode"

#. Tooltip for option widget 选择命令方块蓝图的模式。
#. 手动：手动选择模仿的器械。
#. 前位：自动模仿上一个选择的器械。
#: Option meta file
msgctxt "option.tooltip"
msgid ""
"选择命令方块蓝图的模式。\n"
"手动：手动选择模仿的器械。\n"
"前位：自动模仿上一个选择的器械。"
msgstr ""
"Selection mode for Command Block.\n"
"Manual: Manually select the blueprint to imitate.\n"
"Previous: Automatically imitate the last selected blueprint."

#. Label for option widget 屏幕布局
#: Option meta file
msgctxt "option.name"
msgid "屏幕布局"
msgstr "Screen Layout"

#. Tooltip for option widget 切换游戏的屏幕显示布局，这会影响屏幕显示比例，以及关卡中的界面布局。
#: Option meta file
msgctxt "option.tooltip"
msgid "切换游戏的屏幕显示布局，这会影响屏幕显示比例，以及关卡中的界面布局。"
msgstr ""
"Switch the game's screen display layout. This will affect the screen aspect "
"ratio as well as the interface layout within levels."

#. Label for option widget 分辨率
#: Option meta file
msgctxt "option.name"
msgid "分辨率"
msgstr "Resolution"

#. Label for option widget 全屏
#: Option meta file
msgctxt "option.name"
msgid "全屏"
msgstr "Full Screen"

#. Tooltip for option widget 是否全屏。
#: Option meta file
msgctxt "option.tooltip"
msgid "是否全屏。"
msgstr "Option to enable fullscreen mode."

#. Label for option widget 垂直同步
#: Option meta file
msgctxt "option.name"
msgid "垂直同步"
msgstr "V-Sync"

#. Tooltip for option widget 是否开启垂直同步。垂直同步可以防止画面撕裂，但会使目标帧率设置无效化。
#: Option meta file
msgctxt "option.tooltip"
msgid "是否开启垂直同步。垂直同步可以防止画面撕裂，但会使目标帧率设置无效化。"
msgstr ""
"Option to enable v-sync. V-sync can prevent screen tearing, but it will "
"override the target frame rate setting."

#. Label for option widget 目标帧率
#: Option meta file
msgctxt "option.name"
msgid "目标帧率"
msgstr "Target Frame Rate"

#. Tooltip for option widget 游戏的目标帧率。
#. 桌面平台下，默认不限制目标频率。
#. 移动平台下，默认目标帧率固定为30。
#: Option meta file
msgctxt "option.tooltip"
msgid ""
"游戏的目标帧率。\n"
"桌面平台下，默认不限制目标频率。\n"
"移动平台下，默认目标帧率固定为30。"
msgstr ""
"The target frame rate of the game.\n"
"On desktop platforms, the default target frame rate is unrestricted.\n"
"On mobile platforms, the default target frame rate is fixed at 30."

# 选项，{0}为是否开启
#. Label for option widget 显示帧率
#: Option meta file
msgctxt "option.name"
msgid "显示帧率"
msgstr "Show FPS"

#. Tooltip for option widget 是否显示游戏帧率。
#: Option meta file
msgctxt "option.tooltip"
msgid "是否显示游戏帧率。"
msgstr "Option to display FPS."

#. Label for option widget HDR光照
#: Option meta file
msgctxt "option.name"
msgid "HDR光照"
msgstr "HDR Lighting"

#. Tooltip for option widget 是否开启HDR光照。这会让关卡中的光能够提升场景贴图的亮度，但可能会使这些光变得较为刺眼。
#: Option meta file
msgctxt "option.tooltip"
msgid ""
"是否开启HDR光照。这会让关卡中的光能够提升场景贴图的亮度，但可能会使这些光变得"
"较为刺眼。"
msgstr ""
"Option to enable HDR lighting. This allows lights in levels to brighten "
"scene textures but may make them appear overly bright."

#. Label for option widget 粒子数量：{0}
#: Option meta file
msgctxt "option.name"
msgid "粒子数量：{0}"
msgstr "Particle Count: {0}"

#. Tooltip for option widget 粒子效果数量。
#: Option meta file
msgctxt "option.tooltip"
msgid "粒子效果数量。"
msgstr "Particle effect quantity."

#. Label for option widget 屏幕震动：{0}
#: Option meta file
msgctxt "option.name"
msgid "屏幕震动：{0}"
msgstr "Screen Shake: {0}"

#. Tooltip for option widget 屏幕震动幅度。
#: Option meta file
msgctxt "option.tooltip"
msgid "屏幕震动幅度。"
msgstr "Screen shake intensity."

#. Label for option widget 动画频率：{0}
#: Option meta file
msgctxt "option.name"
msgid "动画频率：{0}"
msgstr "Animation Frequency: {0}"

#. Tooltip for option widget 关卡中实体动画的更新速率。降低该值可能会提升性能，但会使实体动画效果变差。
#: Option meta file
msgctxt "option.tooltip"
msgid ""
"关卡中实体动画的更新速率。降低该值可能会提升性能，但会使实体动画效果变差。"
msgstr ""
"Update rate of entity animations in levels. Lowering this may improve "
"performance but will reduce entity animation quality."

#. Label for option widget 血与碎块
#: Option meta file
msgctxt "option.name"
msgid "血与碎块"
msgstr "Blood and Gore"

#. Tooltip for option widget 是否启用游戏中的血腥表现。
#: Option meta file
msgctxt "option.tooltip"
msgid "是否启用游戏中的血腥表现。"
msgstr "Option to enable blood and gore effects in the game."

#. Label for option widget 高度指示器
#: Option meta file
msgctxt "option.name"
msgid "高度指示器"
msgstr "Height Indicator"

#. Tooltip for option widget 是否在关卡中的实体位置较高时，显示实体距离地面的高度。
#: Option meta file
msgctxt "option.tooltip"
msgid "是否在关卡中的实体位置较高时，显示实体距离地面的高度。"
msgstr ""
"Option to display entities' height above ground when their position is "
"elevated in a level."

#. Label for option widget 启用血条
#: Option meta file
msgctxt "option.name"
msgid "启用血条"
msgstr "Enabled"

#. Tooltip for option widget 是否在关卡中启用血条显示。
#: Option meta file
msgctxt "option.tooltip"
msgid "是否在关卡中启用血条显示。"
msgstr "Option to display HP bars in a level."

#. Label for option widget 自动隐藏
#: Option meta file
msgctxt "option.name"
msgid "自动隐藏"
msgstr "Auto Hide"

#. Tooltip for option widget 是否隐藏满血实体的血条。
#: Option meta file
msgctxt "option.tooltip"
msgid "是否隐藏满血实体的血条。"
msgstr "Option to auto-hide full health entities' HP bars"

#. Label for option widget 数值模式
#: Option meta file
msgctxt "option.name"
msgid "数值模式"
msgstr "Amount Mode"

#. Tooltip for option widget 选择血条数值的显示模式。
#. 隐藏：不显示血条数值。
#. 当前血量：只显示当前血量。
#. 全部：显示当前血量和最大血量。
#: Option meta file
msgctxt "option.tooltip"
msgid ""
"选择血条数值的显示模式。\n"
"隐藏：不显示血条数值。\n"
"当前血量：只显示当前血量。\n"
"全部：显示当前血量和最大血量。"
msgstr ""
"The display mode for HP bar value.\n"
"Hidden: Do not display value.\n"
"Current: Only displays the current HP value.\n"
"All: Display current and maximum HP value."

# 选项，{0}为是否开启
#. Label for option widget 悬停显示范围：{0}
#: Option meta file
msgctxt "option.name"
msgid "悬停显示范围：{0}"
msgstr "Hover Display Range: {0}"

#. Tooltip for option widget 鼠标或者触摸指针位于实体一定范围内时，会强制显示血条。
#: Option meta file
msgctxt "option.tooltip"
msgid "鼠标或者触摸指针位于实体一定范围内时，会强制显示血条。"
msgstr ""
"When the mouse or touch pointer is within a certain range of the entity, the "
"HP bar will be forcibly displayed."

# 选项，{0}为是否开启
#. Label for option widget 显示快捷键
#: Option meta file
msgctxt "option.name"
msgid "显示快捷键"
msgstr "Show Hot Keys"

#. Tooltip for option widget 是否在关卡中显示界面对应的快捷键。
#: Option meta file
msgctxt "option.tooltip"
msgid "是否在关卡中显示界面对应的快捷键。"
msgstr "Option to display the corresponding hotkeys for the UI in a level."

#. Label for option widget 快捷键设置
#: Option meta file
msgctxt "option.name"
msgid "快捷键设置"
msgstr "Hotkeys"

