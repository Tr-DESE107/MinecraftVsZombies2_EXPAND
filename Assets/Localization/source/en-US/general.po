msgid "杀死所有器械。"
msgstr "Kills all contraptions."

#. Description for command variant "mvz2:kill obstacle"
#: Commands meta file
msgctxt "command_variant.description"
msgid "杀死所有障碍物。"
msgstr "Kills all obstacles."

#. Description for command variant "mvz2:kill boss"
#: Commands meta file
msgctxt "command_variant.description"
msgid "杀死所有头目。"
msgstr "Kills all bosses."

#. Description for command variant "mvz2:kill all"
#: Commands meta file
msgctxt "command_variant.description"
msgid "杀死所有实体。"
msgstr "Kills all entities."

#. Description for command "mvz2:blueprint"
